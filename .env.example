# Copy to .env and fill in the values:  cp .env.example .env
COMPOSE_PROJECT_NAME=hr-app

# PostgreSQL
DB_USERNAME=admin
DB_PASSWORD=change-me

# SMTP (Gmail: use an App Password, not your account password)
MAIL_USERNAME=you@example.com
MAIL_PASSWORD=change-me

# JWT signing key, at least 64 bytes for HS512. Generate one with:  openssl rand -base64 64
JWT_SECRET=change-me

# Optional overrides
# JWT_EXPIRATION_MS=86400000
# CORS_ALLOWED_ORIGINS=http://localhost:3000
# DRIVE_STORAGE_PATH=/path/to/hr-workflow-files
# NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1
